{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "*.ts",
    "memory/**/*.ts",
    "src/**/*.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "agent-console",
    "dist",
    "**/*.js",
    "**/*.d.ts",
    "**/*.tsbuildinfo"
  ]
}
