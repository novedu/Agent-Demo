{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@runtime/*": ["./packages/agent-runtime/src/*"],
      "@shared/*": ["./packages/shared-utils/src/*"],
      "@shared-types/*": ["./packages/shared-types/src/*"]
    },
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "apps/runtime-server/src/**/*.ts",
    "./packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "agent-console",
    "dist",
    "**/*.js",
    "**/*.d.ts",
    "**/*.tsbuildinfo"
  ]
}
